# Generated artefacts. Everything here is derived from persona/, rubric/ and
# the scripts, so it is never committed: a committed calendar or draft is a
# stale copy that disagrees with the config that produced it.
output/*
!output/.gitkeep
!output/audit/
!output/drafts/
!output/reports/
output/audit/*
!output/audit/.gitkeep
output/drafts/*
!output/drafts/.gitkeep
output/reports/*
!output/reports/.gitkeep

# Queue files are exports for an external system, not source.
queue.csv
queue.csv.status

# Reports name real people and quote their profiles. Audit output is derived from
# the local profile snapshot, so it carries the same sensitivity.
output/reports/*
!output/reports/.gitkeep
output/audit/*
!output/audit/.gitkeep

# Real profile snapshots. These contain a real person's name, employers, location
# and contact details, and this repository may be public. Keep them local.
data/profiles/
data/imports/
*.private.json

# Belt and braces: a scraped export anywhere in the tree, whatever it is called.
# A real LinkedIn export contains `custom_url_slug` plus a populated `about`;
# no fixture in this repo has both a real slug and a filled About.
**/scraped-*.json
**/*-linkedin.json
profile-*.json
import-*.json
!data/examples/*.json

# Published history contains every post ever written. Useful locally, not
# something that belongs in a repository.
output/published.jsonl
published.jsonl

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Never commit credentials
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Nothing in this repo needs a build step. A lockfile appearing means someone
# added a dependency; the repo is intentionally dependency-free.
# ---------------------------------------------------------------------------
package-lock.json
yarn.lock
pnpm-lock.yaml